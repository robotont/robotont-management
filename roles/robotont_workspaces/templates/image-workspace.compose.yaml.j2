# Workspace "{{ workspace }}": generated by "4. Run image" on {{ '%Y-%m-%d %H:%M' | strftime }} from
# the image below. Not part of the repository: "2. Deploy" leaves it in place, "4. Run image" with
# the same name rewrites it. Remove it with: sudo rm -r /srv/robotont/workspaces/{{ workspace }}
services:
  app:
    extends:
      file: ../_common/services.yaml
      service: {{ 'hardware' if hardware | bool else 'ros-app' }}
    image: {{ image | to_json }}
    container_name: robotont-{{ workspace }}
{% if command | default('') | length > 0 %}
    command: {{ command | to_json }}
{% endif %}
    labels:
      robotont.workspace: "${ROBOTONT_WORKSPACE:-unknown}"
      robotont.devices: "{{ 'mainboard,lidar,gamepad' if hardware | bool else '' }}"
      robotont.source: "4. Run image"
