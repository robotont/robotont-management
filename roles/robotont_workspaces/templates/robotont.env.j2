# Managed by Ansible (roles/robotont_workspaces). Read by robotont.service (EnvironmentFile) and by
# docker compose (--env-file) through robotont-workspace. The active workspace is operational state in
# /etc/robotont/workspace, not here.
ROBOTONT_ID={{ robotont_id }}
ROS_DOMAIN_ID={{ robotont_ros_domain_id }}
ROS_DISTRO={{ ros_distribution }}
ROBOTONT_GENERATION={{ robotont_generation }}
ROBOTONT_NAMESPACE={{ robotont_namespace }}
ROBOTONT_REALSENSE={{ robotont_realsense | string | lower }}
ROBOTONT_LIDAR={{ robotont_lidar | string | lower }}
ROBOTONT_CAMERA={{ robotont_camera | string | lower }}
ROBOTONT_SLAM={{ robotont_slam | string | lower }}
ROBOTONT_BRINGUP_ARGS="{{ robotont_bringup_args | trim }}"
ROBOTONT_DRIVER_DEVICES={{ robotont_driver_devices }}
ROBOTONT_RELEASE={{ robotont_release }}
ROBOTONT_IMAGE_REPO={{ robotont_image_repo }}
ROBOTONT_BASE_IMAGE={{ robotont_base_image }}
ROBOTONT_HOST_WS={{ robotont_host_ws }}
ROBOTONT_USER_HOME=/home/{{ robotont_user }}
STUDENT_PASSWORD={{ robotont_student_password | default('') }}
