# Managed by Ansible (roles/robotont_workspaces). Runs the workspace named in /etc/robotont/workspace:
# a docker compose project in the foreground, or the host bringup for workspace "host".
[Unit]
Description=Robotont runtime (workspace from /etc/robotont/workspace)
Documentation=https://github.com/robotont/robotont-management
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
User={{ robotont_user }}
EnvironmentFile=/etc/robotont/robotont.env
WorkingDirectory={{ robotont_root }}
ExecStart=/usr/local/bin/robotont-workspace run
ExecStop=/usr/local/bin/robotont-workspace down
Restart=always
RestartSec=5
TimeoutStopSec=45
KillMode=mixed

[Install]
WantedBy=multi-user.target
