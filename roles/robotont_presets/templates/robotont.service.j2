# Managed by Ansible (roles/robotont_presets). Runs the preset named in /etc/robotont/preset:
# a docker compose project in the foreground, or the host bringup for preset "host".
[Unit]
Description=Robotont runtime (preset from /etc/robotont/preset)
Documentation=https://github.com/robotont/robotont-management
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
User={{ robotont_user }}
EnvironmentFile=/etc/robotont/robotont.env
WorkingDirectory={{ robotont_root }}
ExecStart=/usr/local/bin/robotont-preset run
ExecStop=/usr/local/bin/robotont-preset down
Restart=always
RestartSec=5
TimeoutStopSec=45
KillMode=mixed

[Install]
WantedBy=multi-user.target
