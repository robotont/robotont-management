# Managed by Ansible (roles/robotont_stacks). Runs the stack named in /etc/robotont/stack:
# a docker compose project in the foreground, or the host bringup for stack "host".
[Unit]
Description=Robotont runtime (stack from /etc/robotont/stack)
Documentation=https://github.com/robotont/robotont-management
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
User={{ robotont_user }}
EnvironmentFile=/etc/robotont/robotont.env
WorkingDirectory={{ robotont_root }}
ExecStart=/usr/local/bin/robotont-stack run
ExecStop=/usr/local/bin/robotont-stack down
Restart=always
RestartSec=5
TimeoutStopSec=45
KillMode=mixed

[Install]
WantedBy=multi-user.target
