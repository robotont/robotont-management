# Sample environment for static checks on a developer machine (not deployed):
#   ROBOTONT_ROOT=robot ROBOTONT_ENV_FILE=test/robotont.env ROBOTONT_STATE_FILE=test/stack robot/bin/robotont-stack check driver
#   docker compose -p robotont --env-file test/robotont.env -f robot/stacks/driver/compose.yaml config
ROBOTONT_ID=1
ROS_DOMAIN_ID=1
ROS_DISTRO=jazzy
ROBOTONT_GENERATION=3
ROBOTONT_NAMESPACE=
ROBOTONT_REALSENSE=true
ROBOTONT_LIDAR=false
ROBOTONT_CAMERA=false
ROBOTONT_SLAM=false
ROBOTONT_BRINGUP_ARGS="generation:=3 realsense:=true"
ROBOTONT_DRIVER_DEVICES=mainboard,gamepad
ROBOTONT_RELEASE=2026.09
ROBOTONT_IMAGE_REPO=ghcr.io/robotont
ROBOTONT_BASE_IMAGE=ros:jazzy-ros-base
ROBOTONT_HOST_WS=/home/peko/ros2_ws
ROBOTONT_USER_HOME=/home/peko
STUDENT_PASSWORD=
