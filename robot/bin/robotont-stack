#!/bin/bash
# robotont-stack: select and run the Robotont stack (what runs on the robot).
#   robotont-stack list                 stacks available under /srv/robotont/stacks
#   robotont-stack current              the active stack name (/etc/robotont/stack)
#   robotont-stack status               active stack, service state, running containers
#   robotont-stack check <name>         validate a stack (compose config, device declarations)
#   robotont-stack switch <name>        make <name> active and restart robotont.service
#   robotont-stack pull [name]          pull the images of every stack (or of one); prints "updated" when the active one changed
#   robotont-stack stop                 stop robotont.service (the active stack stays selected)
#   robotont-stack run                  used by robotont.service: run the active stack in the foreground
#   robotont-stack down                 used by robotont.service: stop the compose project
set -euo pipefail

ROBOTONT_ROOT="${ROBOTONT_ROOT:-/srv/robotont}"
STACKS="$ROBOTONT_ROOT/stacks"
ENV_FILE="${ROBOTONT_ENV_FILE:-/etc/robotont/robotont.env}"
STATE_FILE="${ROBOTONT_STATE_FILE:-/etc/robotont/stack}"
PROJECT=robotont
DEVICE_VOCABULARY="mainboard lidar gamepad realsense camera"
EXCLUSIVE_DEVICES="mainboard lidar realsense camera"

usage() { sed -n '2,11p' "$0"; }
die() { echo "robotont-stack: $*" >&2; exit 2; }

current() {
  if [ -s "$STATE_FILE" ]; then tr -d '[:space:]' < "$STATE_FILE"; else echo host; fi
}

list() {
  local d n
  for d in "$STACKS"/*/; do
    [ -d "$d" ] || continue
    n=$(basename "$d")
    [[ "$n" == _* ]] && continue
    echo "$n"
  done
}

stack_dir() {
  local name="$1"
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || die "invalid stack name '$name' (use [a-z0-9-], max 63 characters)"
  [ -d "$STACKS/$name" ] || die "unknown stack '$name'; available: $(list | tr '\n' ' ')"
  echo "$STACKS/$name"
}

compose() {  # compose <stack> <compose args...>
  local dir; dir="$(stack_dir "$1")"; shift
  ROBOTONT_STACK="$(basename "$dir")" docker compose -p "$PROJECT" --env-file "$ENV_FILE" -f "$dir/compose.yaml" "$@"
}

read -r -d '' CHECK_PY <<'PY' || true
import json, os, sys
name, vocab, exclusive = sys.argv[1], set(sys.argv[2].split()), set(sys.argv[3].split())
cfg = json.load(sys.stdin)
present = {
    "mainboard": os.path.exists("/dev/robotont"),
    "lidar": os.path.exists("/dev/lidar"),
    "gamepad": os.path.isdir("/dev/input") and any(f.startswith("js") for f in os.listdir("/dev/input")),
}
claims, errors, warnings = {}, [], []
services = cfg.get("services") or {}
for svc, spec in services.items():
    raw = (spec.get("labels") or {}).get("robotont.devices", "")
    for d in [x.strip() for x in raw.split(",") if x.strip()]:
        if d not in vocab:
            errors.append(f"service '{svc}' declares unknown device '{d}' (vocabulary: {' '.join(sorted(vocab))})")
        claims.setdefault(d, []).append(svc)
        if present.get(d) is False:
            warnings.append(f"service '{svc}' needs '{d}', which is not present right now")
for d, svcs in claims.items():
    if d in exclusive and len(svcs) > 1:
        errors.append(f"exclusive device '{d}' is claimed by {', '.join(svcs)}")
for w in warnings:
    print(f"warning: {w}")
for e in errors:
    print(f"error: {e}", file=sys.stderr)
summary = ", ".join(f"{d} <- {'+'.join(s)}" for d, s in claims.items()) or "none"
print(f"stack '{name}': {len(services)} service(s); devices: {summary}")
sys.exit(1 if errors else 0)
PY

check() {
  local name="$1" dir; dir="$(stack_dir "$name")"
  if [ -f "$dir/run.sh" ] && [ ! -f "$dir/compose.yaml" ]; then
    [ -x "$dir/run.sh" ] || die "$dir/run.sh is not executable"
    echo "stack '$name': host script, ok"
    return 0
  fi
  [ -f "$dir/compose.yaml" ] || die "stack '$name' has neither compose.yaml nor run.sh"
  compose "$name" config --format json | python3 -c "$CHECK_PY" "$name" "$DEVICE_VOCABULARY" "$EXCLUSIVE_DEVICES"
}

images_of() {  # images_of <stack>: image references of a compose stack, one per line
  compose "$1" config --images 2>/dev/null | sort -u
}

image_ids() {  # image_ids <image...>: "<image> <id or missing>" per line
  local img
  for img in "$@"; do
    printf '%s %s\n' "$img" "$(docker image inspect --format '{{.Id}}' "$img" 2>/dev/null || echo missing)"
  done
}

pull() {  # pull [stack]: every stack, or just the one named
  local active before after name dir tmp rc=0 missing=0 names
  if [ $# -ge 1 ]; then stack_dir "$1" > /dev/null; names="$1"; else names="$(list)"; fi
  active="$(current)"
  tmp="$(mktemp)"
  # shellcheck disable=SC2046  # one image reference per word is intended
  before="$(image_ids $(images_of "$active" 2>/dev/null))"
  for name in $names; do
    dir="$STACKS/$name"
    [ -f "$dir/compose.yaml" ] || continue
    echo "pull: stack '$name'"
    if ! compose "$name" pull --quiet --ignore-buildable > "$tmp" 2>&1; then rc=1; fi
    sed 's/^/  /' "$tmp"
    if grep -qE 'denied|not found|manifest unknown' "$tmp"; then
      echo "  hint: an image is not on the registry (CI has not built this release, or the package is private); a local build is used when present"
    fi
  done
  rm -f "$tmp"
  # shellcheck disable=SC2046
  after="$(image_ids $(images_of "$active" 2>/dev/null))"
  if [ "$before" != "$after" ]; then echo "updated: images of the active stack '$active' changed"; fi
  for name in $names; do
    [ -f "$STACKS/$name/compose.yaml" ] || continue
    # shellcheck disable=SC2046
    while read -r img id; do
      [ -n "$img" ] || continue
      if [ "$id" = missing ]; then echo "missing: $img (stack '$name')"; missing=1; fi
    done <<< "$(image_ids $(images_of "$name"))"
  done
  [ "$missing" -eq 0 ] && [ "$rc" -eq 0 ] && echo "pull: every stack image is present"
  [ "$missing" -eq 0 ] && [ "$rc" -eq 0 ]
}

status() {
  echo "stack:  $(current)"
  echo "service: $(systemctl is-active robotont.service 2>/dev/null || echo unknown)"
  docker ps --filter "label=com.docker.compose.project=$PROJECT" \
    --format 'table {{.Names}}\t{{.State}}\t{{.Status}}\t{{.Label "robotont.stack"}}\t{{.Label "robotont.devices"}}' 2>/dev/null \
    || echo "containers: docker not available"
}

case "${1:-status}" in
  list)     list ;;
  current)  current ;;
  status)   status ;;
  check)    [ $# -eq 2 ] || die "usage: robotont-stack check <name>"
            check "$2" ;;
  pull)     pull "${@:2}" ;;
  switch)   [ $# -eq 2 ] || die "usage: robotont-stack switch <name>"
            check "$2"
            printf '%s\n' "$2" > "$STATE_FILE"
            sudo systemctl restart robotont.service
            echo "switched to '$2'"
            status ;;
  stop)     sudo systemctl stop robotont.service
            echo "robotont.service stopped; the selected stack stays '$(current)'" ;;
  run)      name="$(current)"; dir="$(stack_dir "$name")"
            if [ -f "$dir/compose.yaml" ]; then
              exec env ROBOTONT_STACK="$name" docker compose -p "$PROJECT" --env-file "$ENV_FILE" \
                -f "$dir/compose.yaml" up --remove-orphans --no-color
            else
              exec env ROBOTONT_STACK="$name" "$dir/run.sh"
            fi ;;
  down)     name="$(current)"; dir="$STACKS/$name"
            if [ -f "$dir/compose.yaml" ]; then
              ROBOTONT_STACK="$name" docker compose -p "$PROJECT" --env-file "$ENV_FILE" \
                -f "$dir/compose.yaml" down --remove-orphans --timeout 10 || true
            fi
            # containers of a previous stack that the current file does not know about
            leftovers=$(docker ps -aq --filter "label=com.docker.compose.project=$PROJECT" 2>/dev/null || true)
            if [ -n "$leftovers" ]; then
              # shellcheck disable=SC2086
              docker rm -f $leftovers >/dev/null 2>&1 || true
            fi ;;
  -h|--help|help) usage ;;
  *)        die "unknown command '$1' (try: robotont-stack help)" ;;
esac
