#!/usr/bin/env python3
"""robotont-metrics: workspace, container and device state as node_exporter textfile metrics and status.json.

Runs from robotont-metrics.timer as root. Depends on python3 and the docker CLI only.
Outputs:
  /var/lib/prometheus/node-exporter/robotont.prom   (only when that directory exists)
  /run/robotont/status.json                         (always; read by robotont-status and containers)
Use --print to also print the metrics. Paths can be overridden with ROBOTONT_STATUS_DIR and
ROBOTONT_TEXTFILE_DIR for testing.
"""
import glob
import json
import os
import subprocess
import sys
import time

PROJECT = "robotont"
ENV_FILE = "/etc/robotont/robotont.env"
WORKSPACE_FILE = "/etc/robotont/workspace"
FW_FILE = "/etc/robotont/firmware-version"
PROM_DIR = os.environ.get("ROBOTONT_TEXTFILE_DIR", "/var/lib/prometheus/node-exporter")
STATUS_DIR = os.environ.get("ROBOTONT_STATUS_DIR", "/run/robotont")
EXCLUSIVE = ("mainboard", "lidar", "realsense", "camera")


def realsense_present():
    for path in glob.glob("/sys/bus/usb/devices/*/product"):
        try:
            if "RealSense" in open(path).read():
                return True
        except OSError:
            continue
    return False


DEVICES = {
    "mainboard": lambda: os.path.exists("/dev/robotont"),
    "lidar": lambda: os.path.exists("/dev/lidar"),
    "gamepad": lambda: bool(glob.glob("/dev/input/js*")),
    "realsense": realsense_present,
    # CSI camera (IMX500 on Lite robots): the rp1-cfe video nodes exist only with a sensor attached.
    # /dev/media* and /dev/video* alone are not enough: the Pi's codec and ISP expose them always.
    "camera": lambda: bool(glob.glob("/dev/v4l/by-path/platform-*csi*")),
}


def sh(*args):
    return subprocess.run(args, capture_output=True, text=True, check=True).stdout


def read_env(path):
    env = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    key, value = line.split("=", 1)
                    env[key.strip()] = value.strip().strip('"')
    except OSError:
        pass
    return env


def read_text(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def esc(value):
    return str(value).replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")


def labels(mapping):
    return "{" + ",".join(f'{k}="{esc(v)}"' for k, v in mapping.items()) + "}"


def write_atomic(path, content):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(content)
    os.replace(tmp, path)


def service_state():
    try:
        return subprocess.run(["systemctl", "is-active", "robotont.service"],
                              capture_output=True, text=True).stdout.strip() or "unknown"
    except FileNotFoundError:
        return "unknown"


def collect_containers():
    containers = []
    ids = sh("docker", "ps", "-aq", "--filter", f"label=com.docker.compose.project={PROJECT}").split()
    if not ids:
        return containers
    for c in json.loads(sh("docker", "inspect", *ids)):
        lbl = c.get("Config", {}).get("Labels") or {}
        devices = [d.strip() for d in lbl.get("robotont.devices", "").split(",") if d.strip()]
        containers.append({
            "name": c.get("Name", "").lstrip("/"),
            "service": lbl.get("com.docker.compose.service", ""),
            "workspace": lbl.get("robotont.workspace", ""),
            "image": c.get("Config", {}).get("Image", ""),
            "state": c.get("State", {}).get("Status", "unknown"),
            "restarts": int(c.get("RestartCount", 0)),
            "devices": devices,
        })
    return containers


def main():
    env = read_env(ENV_FILE)
    workspace = read_text(WORKSPACE_FILE, "host") or "host"
    release = env.get("ROBOTONT_RELEASE", "")
    firmware = read_text(FW_FILE)
    service = service_state()

    docker_ok = True
    containers = []
    try:
        containers = collect_containers()
    except (subprocess.CalledProcessError, FileNotFoundError, json.JSONDecodeError, ValueError):
        docker_ok = False

    present = {name: int(bool(probe())) for name, probe in DEVICES.items()}
    claims = {}
    for c in containers:
        if c["state"] == "running":
            for d in c["devices"]:
                claims.setdefault(d, []).append(c["service"])

    lines = [
        "# robotont-metrics: workspace, containers and devices of this robot",
        f'robotont_workspace_info{labels({"workspace": workspace, "release": release})} 1',
        f'robotont_info{labels({"release": release, "firmware": firmware})} 1',
        f'robotont_service_active {1 if service == "active" else 0}',
        f"robotont_docker_available {1 if docker_ok else 0}",
    ]
    for c in containers:
        base = {"workspace": c["workspace"], "service": c["service"]}
        lines.append(f'robotont_container_state{labels({**base, "state": c["state"]})} 1')
        lines.append(f'robotont_container_restarts_total{labels(base)} {c["restarts"]}')
        lines.append(f'robotont_container_up{labels({**base, "image": c["image"]})} {1 if c["state"] == "running" else 0}')
        for d in c["devices"]:
            lines.append(f'robotont_container_device{labels({**base, "device": d})} 1')
    for d, v in present.items():
        lines.append(f'robotont_device_present{labels({"device": d})} {v}')
    for d in EXCLUSIVE:
        lines.append(f'robotont_device_conflict{labels({"device": d})} {1 if len(claims.get(d, [])) > 1 else 0}')
    lines.append(f"robotont_metrics_timestamp_seconds {int(time.time())}")
    prom = "\n".join(lines) + "\n"

    status = {
        "time": int(time.time()), "workspace": workspace, "release": release, "firmware": firmware,
        "service": service, "docker": docker_ok, "containers": containers,
        "devices": present, "claims": claims,
    }
    try:
        os.makedirs(STATUS_DIR, exist_ok=True)
        write_atomic(os.path.join(STATUS_DIR, "status.json"), json.dumps(status, indent=2) + "\n")
    except OSError as exc:
        print(f"robotont-metrics: cannot write status.json: {exc}", file=sys.stderr)
    if os.path.isdir(PROM_DIR):
        write_atomic(os.path.join(PROM_DIR, "robotont.prom"), prom)
    if "--print" in sys.argv:
        print(prom, end="")


if __name__ == "__main__":
    main()
