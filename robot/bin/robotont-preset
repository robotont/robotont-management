#!/bin/bash
# robotont-preset: select and run the Robotont runtime preset.
#   robotont-preset list                 presets available under /opt/robotont/presets
#   robotont-preset current              the active preset name (/etc/robotont/preset)
#   robotont-preset status               active preset, service state, running containers
#   robotont-preset check <name>         validate a preset (compose config, device declarations)
#   robotont-preset switch <name>        make <name> active and restart robotont.service
#   robotont-preset stop                 stop robotont.service (the active preset stays selected)
#   robotont-preset run                  used by robotont.service: run the active preset in the foreground
#   robotont-preset down                 used by robotont.service: stop the compose project
set -euo pipefail

ROBOTONT_ROOT="${ROBOTONT_ROOT:-/opt/robotont}"
PRESETS="$ROBOTONT_ROOT/presets"
ENV_FILE="${ROBOTONT_ENV_FILE:-/etc/robotont/robotont.env}"
STATE_FILE="${ROBOTONT_STATE_FILE:-/etc/robotont/preset}"
PROJECT=robotont
DEVICE_VOCABULARY="mainboard lidar gamepad realsense camera"
EXCLUSIVE_DEVICES="mainboard lidar realsense camera"

usage() { sed -n '2,10p' "$0"; }
die() { echo "robotont-preset: $*" >&2; exit 2; }

current() {
  if [ -s "$STATE_FILE" ]; then tr -d '[:space:]' < "$STATE_FILE"; else echo host; fi
}

list() {
  local d n
  for d in "$PRESETS"/*/; do
    [ -d "$d" ] || continue
    n=$(basename "$d")
    [[ "$n" == _* ]] && continue
    echo "$n"
  done
}

preset_dir() {
  local name="$1"
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || die "invalid preset name '$name' (use [a-z0-9-], max 31 characters)"
  [ -d "$PRESETS/$name" ] || die "unknown preset '$name'; available: $(list | tr '\n' ' ')"
  echo "$PRESETS/$name"
}

compose() {  # compose <preset> <compose args...>
  local dir; dir="$(preset_dir "$1")"; shift
  ROBOTONT_PRESET="$(basename "$dir")" docker compose -p "$PROJECT" --env-file "$ENV_FILE" -f "$dir/compose.yaml" "$@"
}

read -r -d '' CHECK_PY <<'PY' || true
import json, os, sys
name, vocab, exclusive = sys.argv[1], set(sys.argv[2].split()), set(sys.argv[3].split())
cfg = json.load(sys.stdin)
present = {
    "mainboard": os.path.exists("/dev/robotont"),
    "lidar": os.path.exists("/dev/lidar"),
    "gamepad": os.path.isdir("/dev/input") and any(f.startswith("js") for f in os.listdir("/dev/input")),
}
claims, errors, warnings = {}, [], []
services = cfg.get("services") or {}
for svc, spec in services.items():
    raw = (spec.get("labels") or {}).get("robotont.devices", "")
    for d in [x.strip() for x in raw.split(",") if x.strip()]:
        if d not in vocab:
            errors.append(f"service '{svc}' declares unknown device '{d}' (vocabulary: {' '.join(sorted(vocab))})")
        claims.setdefault(d, []).append(svc)
        if present.get(d) is False:
            warnings.append(f"service '{svc}' needs '{d}', which is not present right now")
for d, svcs in claims.items():
    if d in exclusive and len(svcs) > 1:
        errors.append(f"exclusive device '{d}' is claimed by {', '.join(svcs)}")
for w in warnings:
    print(f"warning: {w}")
for e in errors:
    print(f"error: {e}", file=sys.stderr)
summary = ", ".join(f"{d} <- {'+'.join(s)}" for d, s in claims.items()) or "none"
print(f"preset '{name}': {len(services)} service(s); devices: {summary}")
sys.exit(1 if errors else 0)
PY

check() {
  local name="$1" dir; dir="$(preset_dir "$name")"
  if [ -f "$dir/run.sh" ] && [ ! -f "$dir/compose.yaml" ]; then
    [ -x "$dir/run.sh" ] || die "$dir/run.sh is not executable"
    echo "preset '$name': host script, ok"
    return 0
  fi
  [ -f "$dir/compose.yaml" ] || die "preset '$name' has neither compose.yaml nor run.sh"
  compose "$name" config --format json | python3 -c "$CHECK_PY" "$name" "$DEVICE_VOCABULARY" "$EXCLUSIVE_DEVICES"
}

status() {
  echo "preset:  $(current)"
  echo "service: $(systemctl is-active robotont.service 2>/dev/null || echo unknown)"
  docker ps --filter "label=com.docker.compose.project=$PROJECT" \
    --format 'table {{.Names}}\t{{.State}}\t{{.Status}}\t{{.Label "robotont.preset"}}\t{{.Label "robotont.devices"}}' 2>/dev/null \
    || echo "containers: docker not available"
}

case "${1:-status}" in
  list)     list ;;
  current)  current ;;
  status)   status ;;
  check)    [ $# -eq 2 ] || die "usage: robotont-preset check <name>"
            check "$2" ;;
  switch)   [ $# -eq 2 ] || die "usage: robotont-preset switch <name>"
            check "$2"
            printf '%s\n' "$2" > "$STATE_FILE"
            sudo systemctl restart robotont.service
            echo "switched to '$2'"
            status ;;
  stop)     sudo systemctl stop robotont.service
            echo "robotont.service stopped; the selected preset stays '$(current)'" ;;
  run)      name="$(current)"; dir="$(preset_dir "$name")"
            if [ -f "$dir/compose.yaml" ]; then
              exec env ROBOTONT_PRESET="$name" docker compose -p "$PROJECT" --env-file "$ENV_FILE" \
                -f "$dir/compose.yaml" up --remove-orphans --no-color
            else
              exec env ROBOTONT_PRESET="$name" "$dir/run.sh"
            fi ;;
  down)     name="$(current)"; dir="$PRESETS/$name"
            if [ -f "$dir/compose.yaml" ]; then
              ROBOTONT_PRESET="$name" docker compose -p "$PROJECT" --env-file "$ENV_FILE" \
                -f "$dir/compose.yaml" down --remove-orphans --timeout 10 || true
            fi
            # containers of a previous preset that the current file does not know about
            leftovers=$(docker ps -aq --filter "label=com.docker.compose.project=$PROJECT" 2>/dev/null || true)
            if [ -n "$leftovers" ]; then
              # shellcheck disable=SC2086
              docker rm -f $leftovers >/dev/null 2>&1 || true
            fi ;;
  -h|--help|help) usage ;;
  *)        die "unknown command '$1' (try: robotont-preset help)" ;;
esac
