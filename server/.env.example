# Copy to server/.env (gitignored) and fill in. Read by docker compose (--env-file) and passed
# into the container (env_file).

# First admin account, created on the first start.
SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_NAME=Robotont Maintainer
SEMAPHORE_ADMIN_EMAIL=admin@example.org
SEMAPHORE_ADMIN_PASSWORD=change-me

# Encrypts the stored SSH keys and passwords (peko's sudo password) at rest.
# Generate with:  head -c32 /dev/urandom | base64
SEMAPHORE_ACCESS_KEY_ENCRYPTION=

# Optional: set when Semaphore is reached through another hostname than localhost.
# SEMAPHORE_WEB_ROOT=http://localhost:3000
