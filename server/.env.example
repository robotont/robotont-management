# Copy to server/.env (gitignored). Read by docker compose and by server/bootstrap.py, which puts
# these values into Semaphore's key store and environment. Robot-side values only: the Semaphore
# admin is admin/admin and needs nothing here.

# Private key that opens the robots as the robot user (its public half is in the robots'
# ~peko/.ssh/authorized_keys). Absolute path on this machine.
ROBOT_SSH_KEY_FILE=/Users/you/.ssh/id_ed25519
ROBOT_USER=peko
ROBOT_SUDO_PASSWORD=

# Hotspot password written by the robotont-setup NUC branch (variable wifi_pass)
WIFI_PASS=
# Raspberry Pi branch: hotspot password and the lab Wi-Fi the robots join when in range
WIFI_HOTSPOT_PASSWORD=
WIFI_CLIENT_SSID=
WIFI_CLIENT_PASSWORD=

# Optional: 0.0.0.0 to serve the LAN instead of localhost only
# SEMAPHORE_BIND=127.0.0.1
